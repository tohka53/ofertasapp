# Copia este archivo como server/.env para personalizar el servidor.
# Ninguna de las fuentes conectadas requiere claves: las tiendas VTEX exponen APIs públicas de catálogo.

# Puerto y host del API (Angular usa proxy hacia este puerto en desarrollo).
PORT=3000
HOST=127.0.0.1

# Límite de tiempo por consulta a cada tienda (ms).
STORE_TIMEOUT_MS=8000

# Resultados pedidos a cada tienda por búsqueda (máximo 50).
SEARCH_RESULTS_PER_STORE=24

# Microcaché en memoria para respuestas públicas idénticas (ms). 0 desactiva.
HTTP_CACHE_TTL_MS=60000

# Consultas simultáneas máximas por dominio de tienda.
MAX_CONCURRENT_REQUESTS_PER_HOST=4

# Identificación del cliente HTTP ante las tiendas.
HTTP_USER_AGENT="Mozilla/5.0 (compatible; ComparAhorro/0.1; demo local)"

# Carpeta con la compilación de Angular para servirla desde Express (opcional).
# Por defecto: ../comparahorro/dist/comparahorro/browser si existe.
# STATIC_DIR=

# API oficial de Kroger (EE. UU.): cuenta gratuita en https://developer.kroger.com,
# aplicación con el alcance product.compact. Sin estas variables, Kroger aparece como pendiente.
# KROGER_CLIENT_ID=
# KROGER_CLIENT_SECRET=
# KROGER_API_BASE_URL=https://api.kroger.com

# Credenciales de integraciones futuras (PriceSmart, SUMA) irían aquí cuando exista un acceso autorizado.
# Nunca se exponen a Angular.
