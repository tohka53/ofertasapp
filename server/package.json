{
  "name": "comparahorro-server",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor de ComparAhorro: consulta fuentes públicas de tiendas y normaliza sus respuestas. Sin base de datos.",
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify:stores": "tsx --env-file-if-exists=.env scripts/verify-stores.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
